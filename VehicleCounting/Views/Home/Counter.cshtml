@{
    ViewData["Title"] = "Counter Page";
}
<div class="container">

    <!-- BIG VIDEO PLAYER -->
    <div class="left">
        <video id="mainVideo" controls></video>
    </div>

    <!-- RIGHT SIDE -->
    <div class="right">

        <div id="videoList"></div>

        <input type="file" id="upload" accept="video/*" hidden>
        <button class="upload-btn" onclick="document.getElementById('upload').click()">
            UPLOAD
        </button>

    </div>

</div>

<script src="site.js"></script>